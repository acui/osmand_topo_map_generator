+                QJsonObject georef;
+                georef.insert(QStringLiteral("width"), static_cast<double>(configuration.outputRasterWidth));
+                georef.insert(QStringLiteral("height"), static_cast<double>(configuration.outputRasterHeight));
+                georef.insert(QStringLiteral("zoom"), static_cast<double>(configuration.zoom));
+                const OsmAnd::PointD cornerScreenPoints[4] = {
+                    OsmAnd::PointD(0.0, 0.0),
+                    OsmAnd::PointD(configuration.outputRasterWidth - 1.0, 0.0),
+                    OsmAnd::PointD(configuration.outputRasterWidth - 1.0, configuration.outputRasterHeight - 1.0),
+                    OsmAnd::PointD(0.0, configuration.outputRasterHeight - 1.0),
+                };
+                const QString cornerNames[4] = {
+                    QStringLiteral("topLeft"), QStringLiteral("topRight"),
+                    QStringLiteral("bottomRight"), QStringLiteral("bottomLeft")
+                };
+                QJsonArray cornerArray;
+                bool georefOk = true;
+                for (auto cornerIndex = 0; cornerIndex < 4; cornerIndex++)
+                {
+                    OsmAnd::PointI location31;
+                    if (!mapRenderer->getLocationFromScreenPoint(cornerScreenPoints[cornerIndex], location31))
+                    {
+                        georefOk = false;
+                        break;
+                    }
+                    QJsonObject corner;
+                    corner.insert(QStringLiteral("x"), cornerScreenPoints[cornerIndex].x);
+                    corner.insert(QStringLiteral("y"), cornerScreenPoints[cornerIndex].y);
+                    corner.insert(QStringLiteral("lat"), OsmAnd::Utilities::getLatitudeFromTile(OsmAnd::ZoomLevel31, location31.y));
+                    corner.insert(QStringLiteral("lon"), OsmAnd::Utilities::getLongitudeFromTile(OsmAnd::ZoomLevel31, location31.x));
+                    corner.insert(QStringLiteral("name"), cornerNames[cornerIndex]);
+                    cornerArray.append(corner);
+                }
+                georef.insert(QStringLiteral("corners"), cornerArray);
+                georef.insert(QStringLiteral("valid"), georefOk);
+
+                const auto georefFilename = savedImageFilename + QStringLiteral(".georef.json");
+                QFile georefFile(georefFilename);
+                if (georefFile.open(QIODevice::WriteOnly | QIODevice::Truncate))
